// Block: button
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 20px;
  font-size: 16px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  background-color: #007bff;
  color: #fff;
  transition: background-color 0.3s ease;

  // Modifier: button--primary
  &--primary {
    background-color: #007bff;
    &:hover {
      background-color: #0056b3;
    }
  }

  // Modifier: button--secondary
  &--secondary {
    background-color: #6c757d;
    &:hover {
      background-color: #5a6268;
    }
  }

  // Modifier: button--disabled
  &--disabled {
    background-color: #e0e0e0;
    color: #6c757d;
    cursor: not-allowed;
  }

  // Element: button__icon
  &__icon {
    margin-right: 8px;
    display: flex;
    align-items: center;

    // Modifier: button__icon--large
    &--large {
      width: 24px;
      height: 24px;
    }
  }

  // Element: button__label
  &__label {
    font-weight: bold;
  }
}


************ HTML **************

<!-- Primary Button -->
<button class="button button--primary">
  <span class="button__icon">
    <img src="icon.png" alt="Icon" />
  </span>
  <span class="button__label">Primary</span>
</button>

<!-- Secondary Button -->
<button class="button button--secondary">
  <span class="button__label">Secondary</span>
</button>

<!-- Disabled Button -->
<button class="button button--disabled" disabled>
  <span class="button__label">Disabled</span>
</button>
